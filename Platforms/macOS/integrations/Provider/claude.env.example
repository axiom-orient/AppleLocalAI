# Source in the CLIENT terminal after exporting the SAME token as the provider.
# Never put the provider token into an untracked-but-world-readable example file.
: "${APPLELOCALAI_TOKEN:?Export the provider local token first}"
export ANTHROPIC_BASE_URL=http://127.0.0.1:8765
export ANTHROPIC_AUTH_TOKEN="$APPLELOCALAI_TOKEN"
unset ANTHROPIC_API_KEY
export ANTHROPIC_MODEL=apple-local
export ANTHROPIC_DEFAULT_HAIKU_MODEL=apple-local
export ANTHROPIC_DEFAULT_SONNET_MODEL=apple-local
export ANTHROPIC_DEFAULT_OPUS_MODEL=apple-local
export CLAUDE_CODE_DISABLE_THINKING=1
export MAX_THINKING_TOKENS=0
export DISABLE_PROMPT_CACHING=1
export ENABLE_TOOL_SEARCH=false
# /v1/messages/count_tokens is intentionally 501 until qualified. Full Claude
# Code compatibility is not established merely by setting these variables.
